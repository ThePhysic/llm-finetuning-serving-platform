FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements/cpu.lock /app/requirements/cpu.lock
RUN pip install --no-cache-dir --require-hashes -r requirements/cpu.lock
COPY pyproject.toml /app/
COPY src /app/src
RUN pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home platform
USER platform
EXPOSE 8000
ENTRYPOINT ["llm-platform"]
CMD ["doctor"]
